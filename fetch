#!/usr/bin/env bash
# Hosted at https://darianbr.github.io/makefiles/fetch
#
# Downloads a module (plus shared root/core files) from the published
# makefiles site into the local .makefiles/ cache.
#
# Usage: fetch <module> [--force]
#   <module>    module name, e.g. composer or docker
#   --force     refetch even if the module is already present
#
# Which files belong to a module is listed in modules/manifest.txt (one path
# per line, relative to modules/). This script always fetches the root
# Makefile, shared core files, then every file the manifest assigns to the
# requested module.

set -euo pipefail

BASE_URL="${MAKEFILES_BASE_URL:-https://darianbr.github.io/makefiles/modules}"
DEST=".makefiles/modules"
MANIFEST="$DEST/manifest.txt"

if [ -z "${1:-}" ]; then
  echo "Error: no module name provided." >&2
  echo "Usage: fetch <module> [--force]" >&2
  exit 1
fi

MODULE="$1"
FORCE="${2:-}"

# Skip the network entirely if the module is already fetched.
if [ -f "$DEST/$MODULE/Makefile" ] && [ "$FORCE" != "--force" ]; then
  echo "Module '$MODULE' already present under $DEST/$MODULE/ (use --force to refetch)."
  exit 0
fi

# 1. Pull the manifest -- the source of truth for which files exist.
mkdir -p "$DEST"
curl -sf "$BASE_URL/manifest.txt" -o "$MANIFEST"

# 2. Collect files to download: root Makefile + shared core files + this
#    module's files.
files=""
while IFS= read -r line; do
  case "$line" in
    Makefile)    files="$files $line" ;;
    core/*)      files="$files $line" ;;
    "$MODULE"/*) files="$files $line" ;;
  esac
done < "$MANIFEST"

if [ -z "$files" ]; then
  echo "Error: module '$MODULE' not found in manifest." >&2
  exit 1
fi

# 3. Download each file, preserving its path under .makefiles/modules/.
for f in $files; do
  out="$DEST/$f"
  mkdir -p "$(dirname "$out")"
  echo "Fetching $f ..."
  curl -sf "$BASE_URL/$f" -o "$out"
done

echo "Module '$MODULE' is ready under $DEST/$MODULE/"
